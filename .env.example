# Copia questo file in `.env.local` per sovrascrivere in locale i valori
# pubblici di `.env` (che e' tracciato e serve a Lovable).
#
# Vite espone al bundle client solo le variabili con prefisso `VITE_`.

# Progetto Supabase. Consumate da src/lib/supabaseClient.ts.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# Usata da Lovable per identificare il progetto collegato.
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Disattiva i retry di React Query. La impostano i test end-to-end
# (playwright.config.ts) per non aspettare i backoff sui mock.
VITE_DISABLE_QUERY_RETRIES="false"
