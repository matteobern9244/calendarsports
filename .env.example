# Forma di `.env`, che e' tracciato e lo scrive Lovable Cloud.
#
# Dal 9 ottobre 2026 l'app NON legge queste variabili: il progetto Supabase
# e' fissato in src/lib/supabaseClient.ts, perche' Lovable riscrive `.env` con
# l'indirizzo del suo Cloud. Restano per i file che Lovable genera in
# src/integrations/, che l'app non importa.

# Progetto Supabase di Lovable Cloud.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# Usata da Lovable per identificare il progetto collegato.
VITE_SUPABASE_PROJECT_ID="your-project-id"
